---
import Layout from '../layouts/Layout.astro';
const costumes = [
  'Pulp Fiction','Beetlejuice','Clueless','The Matrix','Barbie','El Extraño Mundo de Jack','Kill Bill','La Familia Addams','El Caballero de la Noche','El Diario de la Princesa','It','Scream','El Quinto Elemento','El Cisne Negro','Legalmente Rubia','La Casa de Papel','Bastardos Sin Gloria','Midsommar','El Gran Lebowski','Joker','Harry Potter','El Señor de los Anillos',
];
---
<Layout title="Juli cumple 30">
  <section class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 text-center">
    <p class="text-neon-cyan neon-text text-sm tracking-widest uppercase">Estreno · 10 de enero de 2027</p>
    <h1 class="text-5xl font-bold text-neon-magenta neon-text sm:text-7xl">Juli cumple 30</h1>
    <p class="max-w-xl text-lg text-gray-300">
      Algunas historias merecen una secuela. La mía cumple 30 y la fiesta es de disfraces. ¿Te sumás al reparto?
    </p>
    <div id="countdown" class="flex gap-4 text-neon-green neon-text font-mono text-2xl" aria-live="polite" aria-label="Cuenta regresiva">
      <span data-part="d">--d</span><span data-part="h">--h</span><span data-part="m">--m</span><span data-part="s">--s</span>
    </div>
    <button id="rsvp-open" class="rounded bg-neon-magenta px-6 py-3 font-semibold text-black hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan">Confirmar asistencia</button>
    <p class="text-sm text-gray-400">Confirmados: <span id="counter">0</span></p>
  </section>

  <section id="ubicacion" class="mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4">Ubicación</h2>
    <p class="text-gray-300 mb-2">Dirección placeholder — se actualiza con el link de Maps</p>
    <a href="https://maps.google.com" target="_blank" rel="noopener" class="text-neon-magenta underline">Ver en Google Maps</a>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4 text-center">Dress code</h2>
    <p class="text-center text-gray-300">Disfraz obligatorio. Si venís de civil, te toca ser extra de fondo 🎬</p>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4 text-center">Ideas de disfraz</h2>
    <div id="carousel" class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4" tabindex="0" aria-label="Carrusel de disfraces">
      {costumes.map((c) => (
        <article class="snap-start shrink-0 w-64 rounded border border-neon-cyan/30 p-4">
          <h3 class="font-semibold text-neon-magenta">{c}</h3>
          <p class="text-sm text-gray-400 mt-2">Item característico (placeholder)</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4 text-center">Playlist</h2>
    <iframe class="w-full aspect-video rounded" src="https://open.spotify.com/embed/playlist/37i9dQZF1DXcBWIGoYBM5M" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
    <form id="track-form" class="mt-4 flex flex-col gap-2 sm:flex-row">
      <input name="title" placeholder="Canción" required class="flex-1 rounded bg-gray-900 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      <input name="artist" placeholder="Artista" required class="flex-1 rounded bg-gray-900 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      <button class="rounded bg-neon-green px-4 py-2 text-black font-semibold">Agregar</button>
    </form>
    <ul id="track-list" class="mt-4 space-y-2 text-sm text-gray-300"></ul>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4 text-center">Galería</h2>
    <div id="gallery-grid" class="grid grid-cols-2 gap-2 sm:grid-cols-3"></div>
    <div id="gallery-carousel" class="mt-6 flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4"></div>
  </section>

  <dialog id="rsvp-modal" class="rounded-lg bg-gray-900 text-gray-100 p-6 w-full max-w-md backdrop:bg-black/70">
    <form id="rsvp-form" class="space-y-4">
      <h2 class="text-xl font-bold text-neon-magenta">Confirmar asistencia</h2>
      <div>
        <label for="name" class="block text-sm mb-1">Nombre</label>
        <input id="name" name="name" required class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      </div>
      <div>
        <label for="companions" class="block text-sm mb-1">Acompañantes</label>
        <input id="companions" name="companions" type="number" min="0" value="0" class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      </div>
      <div>
        <label for="dedication" class="block text-sm mb-1">Dedicatoria (opcional)</label>
        <textarea id="dedication" name="dedication" rows="3" class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" id="rsvp-close" class="px-4 py-2 text-gray-400 hover:text-white">Cerrar</button>
        <button type="submit" class="rounded bg-neon-magenta px-4 py-2 text-black font-semibold">Enviar</button>
      </div>
      <p id="rsvp-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <script>
    const target = new Date('2027-01-10T00:00:00-03:00').getTime();
    const cd = document.getElementById('countdown')!;
    function tick() {
      const diff = target - Date.now();
      if (diff <= 0) { cd.textContent = '¡Es hoy!'; return; }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      const el = (p: string) => cd.querySelector(`[data-part="${p}"]`);
      if (el('d')) el('d')!.textContent = `${d}d`;
      if (el('h')) el('h')!.textContent = `${h}h`;
      if (el('m')) el('m')!.textContent = `${m}m`;
      if (el('s')) el('s')!.textContent = `${s}s`;
    }
    tick(); setInterval(tick, 1000);

    async function refreshCounter() {
      try {
        const r = await fetch('/api/rsvp');
        const j = await r.json();
        document.getElementById('counter')!.textContent = String(j.count ?? 0);
      } catch {}
    }
    refreshCounter(); setInterval(refreshCounter, 15000);

    // RSVP modal
    const modal = document.getElementById('rsvp-modal') as HTMLDialogElement;
    const openBtn = document.getElementById('rsvp-open')!;
    const closeBtn = document.getElementById('rsvp-close')!;
    let lastFocus: HTMLElement | null = null;
    openBtn.addEventListener('click', () => { lastFocus = document.activeElement as HTMLElement; modal.showModal(); });
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('close', () => { if (lastFocus) lastFocus.focus(); });

    const form = document.getElementById('rsvp-form') as HTMLFormElement;
    const status = document.getElementById('rsvp-status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        name: String(fd.get('name') || ''),
        companions: Number(fd.get('companions') || 0),
        dedication: String(fd.get('dedication') || ''),
      };
      const r = await fetch('/api/rsvp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (r.ok) {
        status.textContent = '¡Gracias por confirmar!';
        form.reset();
        refreshCounter();
      } else {
        status.textContent = 'Error al enviar. Intentá de nuevo.';
      }
    });

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    // Playlist
    async function loadTracks() {
      const r = await fetch('/api/tracks');
      const j = await r.json();
      const ul = document.getElementById('track-list')!;
      ul.innerHTML = '';
      for (const t of j.tracks || []) {
        const li = document.createElement('li');
        const q = encodeURIComponent(`${t.title} ${t.artist}`);
        li.innerHTML = `<span class="text-gray-200">${esc(t.title)}</span> <span class="text-gray-500">— ${esc(t.artist)}</span> <a href="https://open.spotify.com/search/${q}" target="_blank" rel="noopener" class="text-neon-green underline ml-2">buscar</a>`;
        ul.appendChild(li);
      }
    }
    loadTracks();
    const trackForm = document.getElementById('track-form') as HTMLFormElement;
    trackForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(trackForm);
      const payload = { title: String(fd.get('title') || ''), artist: String(fd.get('artist') || '') };
      const r = await fetch('/api/tracks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (r.ok) { trackForm.reset(); loadTracks(); }
    });

    // Gallery
    async function loadGallery() {
      const r = await fetch('/api/photos');
      const j = await r.json();
      const grid = document.getElementById('gallery-grid')!;
      const car = document.getElementById('gallery-carousel')!;
      grid.innerHTML = ''; car.innerHTML = '';
      for (const p of j.photos || []) {
        const card = document.createElement('div');
        card.className = 'relative group';
        card.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.alt)}" loading="lazy" class="w-full aspect-square object-cover rounded" />
          <button data-id="${p.id}" class="like-btn absolute bottom-2 right-2 bg-black/60 rounded-full px-3 py-1 text-sm text-white flex items-center gap-1">
            <span class="heart">${p.liked ? '❤️' : '🤍'}</span> <span class="count">${p.likes}</span>
          </button>`;
        grid.appendChild(card);
        const carCard = document.createElement('div');
        carCard.className = 'snap-start shrink-0 w-72';
        carCard.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.alt)}" loading="lazy" class="w-full aspect-[4/3] object-cover rounded" />`;
        car.appendChild(carCard);
      }
      grid.querySelectorAll('.like-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = Number((btn as HTMLElement).dataset.id);
          const r = await fetch('/api/likes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ photoId: id }) });
          if (r.ok) {
            const j = await r.json();
            (btn.querySelector('.count') as HTMLElement).textContent = String(j.likes);
            (btn.querySelector('.heart') as HTMLElement).textContent = '❤️';
          }
        });
      });
    }
    loadGallery();
  </script>
</Layout>