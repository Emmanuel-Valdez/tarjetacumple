---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../data/event';
import { AWARDS, AWARDS_INTRO } from '../data/awards';
import { MOVIES } from '../data/movies';

const mitad = Math.ceil(MOVIES.length / 2);
const peliculasArriba = MOVIES.slice(0, mitad);
const peliculasAbajo = MOVIES.slice(mitad).reverse();
---

<Layout title="Juli: capitulo 30, la pelicula">
  <!-- Fondo único: horizontal en desktop, vertical en mobile. Se difumina al scrollear. -->
  <div class="fondo-cine" aria-hidden="true"></div>

  <section id="hero" class="relative flex min-h-screen flex-col items-center justify-center gap-6 px-4 text-center">
    <p class="text-neon-cyan neon-text text-sm tracking-widest uppercase">Estreno · {EVENT.date}</p>
    <h1 class="text-4xl font-bold text-neon-magenta neon-text sm:text-6xl">Juli: tener 30, ser coqueta y prospera</h1>
    <p class="max-w-xl text-lg text-gray-200">
      Algunas historias merecen una secuela. La mía cumple 30 y la fiesta es de disfraces. ¿Te sumás al reparto?
    </p>
    <div id="countdown" data-target={EVENT.dateISO} class="flex gap-4 text-neon-green neon-text font-mono text-2xl" role="timer" aria-label="Cuenta regresiva para la fiesta">
      <span data-part="d">--d</span><span data-part="h">--h</span><span data-part="m">--m</span><span data-part="s">--s</span>
    </div>
    <div class="flex flex-col items-center gap-3">
      <button id="rsvp-open" class="rounded bg-neon-magenta px-6 py-3 font-semibold text-black hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-cinema-black">Confirmar asistencia</button>
      <p class="text-sm text-gray-300">Ya confirmaron: <span id="counter">0</span> personas</p>
    </div>
  </section>

  <!-- Ubicacion -->
  <section id="ubicacion" class="relative mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4">Dónde y cuándo</h2>
    <p class="text-xl text-gray-100 font-semibold">{EVENT.venue}</p>
    <p class="text-gray-300 mt-1">{EVENT.address}</p>
    <p class="text-neon-green neon-text mt-3 text-lg">{EVENT.date} · {EVENT.time}</p>
    <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="mt-5 inline-block rounded border border-neon-cyan px-4 py-2 text-neon-cyan hover:bg-neon-cyan hover:text-black focus:outline-none focus:ring-2 focus:ring-neon-magenta">Ver en Google Maps</a>
  </section>

  <!-- Dress code -->
  <section class="relative mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4">Dress code</h2>
    <p class="text-gray-200">Disfraz obligatorio y temático. Si venís de civil, te toca ser extra de fondo.</p>
  </section>

  <!-- Solo adultos -->
  <section class="relative mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4">Solo adultos</h2>
    <p class="text-xl text-gray-100 font-semibold">Público: +18</p>
    <p class="text-gray-200 mt-3">
      Si sos menor de edad, te toca ver la película desde la butaca de atrás: sin palomitas,
      sin volumen y sin drama. Esta función es solo para adultos disfrazados.
    </p>
  </section>

  <!-- Qué hay que traer -->
  <section class="relative mx-auto max-w-2xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4 text-center">Qué hay que traer</h2>
    <ul class="mx-auto mt-4 max-w-xl space-y-4">
      <li class="rounded border border-neon-cyan/25 bg-gray-950/60 p-4">
        <h3 class="font-semibold text-neon-magenta flex items-center gap-2"><span aria-hidden="true">🎟️</span> Tu presencia</h3>
        <p class="text-sm text-gray-200 mt-1">Lo único imprescindible. Con aparecer ya ganás el premio al mejor apoyo.</p>
      </li>
      <li class="rounded border border-neon-cyan/25 bg-gray-950/60 p-4">
        <h3 class="font-semibold text-neon-magenta flex items-center gap-2"><span aria-hidden="true">🍸</span> Lo que vayas a tomar</h3>
        <p class="text-sm text-gray-200 mt-1">Cada uno trae su propia bebida alcohólica: cerveza, vino, vodka, fernet, lo que tomes. Si no tomás, también vale tu presencia.</p>
      </li>
    </ul>
  </section>

  <!-- Carrusel de peliculas: reemplaza las ideas de disfraz -->
  <section class="relative mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-2 text-center">Peliculas para inspirarte</h2>
    <p class="text-center text-sm text-gray-400 mb-8">Algunas referencias para tu disfraz.</p>
    <div class="space-y-4 overflow-hidden">
      <div class="movie-row movie-row--left flex gap-3">
        {peliculasArriba.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
        {peliculasArriba.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
      </div>
      <div class="movie-row movie-row--right flex gap-3">
        {peliculasAbajo.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
        {peliculasAbajo.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
      </div>
    </div>
  </section>

  <!-- Premios -->
  <section id="premios" class="relative mx-auto max-w-4xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-4 text-center">Los Premios de la Noche</h2>
    <p class="text-center text-gray-200 max-w-2xl mx-auto">{AWARDS_INTRO}</p>
    <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {AWARDS.map((a) => (
        <li class="rounded border border-cinema-gold/40 bg-gray-950/60 p-3 text-sm">
          <span aria-hidden="true">{a.emoji}</span> <span class="font-semibold text-cinema-gold">{a.title}</span>
          <span class="block text-gray-400 mt-1">{a.teaser}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Playlist -->
  <section class="relative mx-auto max-w-2xl px-4 py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-2 text-center">La banda sonora</h2>
    <p class="text-center text-gray-200 mb-6">¿Qué temazo no puede faltar esta noche? Sumá la tuya y armamos la playlist entre todos.</p>
    <iframe class="w-full aspect-video rounded" src={`https://open.spotify.com/embed/playlist/${EVENT.spotifyPlaylist}`} allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="Playlist de la fiesta"></iframe>
    <form id="track-form" class="mt-6 flex flex-col gap-2 sm:flex-row">
      <label for="track-title" class="sr-only">Canción</label>
      <input id="track-title" name="title" placeholder="Canción" required maxlength="100" class="flex-1 rounded bg-gray-900 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      <label for="track-artist" class="sr-only">Artista</label>
      <input id="track-artist" name="artist" placeholder="Artista" required maxlength="100" class="flex-1 rounded bg-gray-900 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      <button class="rounded bg-neon-green px-4 py-2 text-black font-semibold hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan">Sumar</button>
    </form>
    <p id="track-status" class="text-sm text-neon-green mt-2" role="status" aria-live="polite"></p>
    <ul id="track-list" class="mt-4 space-y-2 text-sm text-gray-200"></ul>
  </section>

  <!-- Galeria: carrusel horizontal con scroll infinito, sin botones -->
  <section class="relative py-16">
    <h2 class="text-2xl font-bold text-neon-cyan neon-text mb-2 text-center px-4">El backstage</h2>
    <p class="text-center text-sm text-gray-400 mb-8 px-4">Deslizá para ver más. Tapá el corazón para dejar tu like.</p>
    <div id="gallery" class="gallery-track" tabindex="0" role="region" aria-label="Galería de fotos de la fiesta">
      <div class="gallery-pista" id="gallery-pista"></div>
    </div>
  </section>

  <!-- RSVP modal -->
  <dialog id="rsvp-modal" class="rounded-lg bg-gray-900 text-gray-100 p-6 w-full max-w-md backdrop:bg-black/70">
    <form id="rsvp-form" class="space-y-4">
      <h2 class="text-xl font-bold text-neon-magenta">Confirmar asistencia</h2>
      <div>
        <label for="name" class="block text-sm mb-1">Nombre</label>
        <input id="name" name="name" required maxlength="100" class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      </div>
      <div>
        <label for="companions" class="block text-sm mb-1">Acompañantes</label>
        <input id="companions" name="companions" type="number" min="0" max="20" value="0" class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
      </div>
      <div>
        <label for="dedication" class="block text-sm mb-1">Dedicatoria (opcional)</label>
        <textarea id="dedication" name="dedication" rows="3" maxlength="500" class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-700 focus:border-neon-cyan focus:outline-none"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" id="rsvp-close" class="px-4 py-2 text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-neon-cyan">Cerrar</button>
        <button type="submit" class="rounded bg-neon-magenta px-4 py-2 text-black font-semibold hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan">Enviar</button>
      </div>
      <p id="rsvp-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <!-- Decoración fija: pocos globos y confetis, se mueven solo con el scroll. -->
  <div class="decor" id="decor" aria-hidden="true">
    <span class="decor-balloon" style="left:5%;top:84%;font-size:2.75rem;--v:0.09">🎈</span>
    <span class="decor-balloon" style="left:88%;top:70%;font-size:2rem;--v:0.05">🎈</span>
    <span class="decor-balloon" style="left:72%;top:92%;font-size:3rem;--v:0.12">🎈</span>
    <span class="decor-balloon" style="left:22%;top:60%;font-size:1.6rem;--v:0.03">🎈</span>
    <span class="decor-confetti" style="left:12%;top:35%;--c:#ff00ff;--r:18deg;--v:0.07"></span>
    <span class="decor-confetti" style="left:35%;top:70%;--c:#00f0ff;--r:-30deg;--v:0.04"></span>
    <span class="decor-confetti" style="left:58%;top:28%;--c:#39ff14;--r:45deg;--v:0.10"></span>
    <span class="decor-confetti" style="left:79%;top:48%;--c:#d4af37;--r:-12deg;--v:0.06"></span>
    <span class="decor-confetti" style="left:93%;top:22%;--c:#ff6b6b;--r:60deg;--v:0.08"></span>
    <span class="decor-confetti" style="left:47%;top:88%;--c:#ffffff;--r:10deg;--v:0.05"></span>
  </div>

  <!-- Música de fondo -->
  <button
    id="music-toggle"
    type="button"
    class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full border border-neon-cyan/50 bg-gray-950/80 px-4 py-2 text-sm text-neon-cyan backdrop-blur focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-cinema-black"
    aria-pressed="true"
    aria-label="Música de fondo"
  >
    <span id="music-icon" aria-hidden="true">🎵</span>
    <span id="music-hint">Tocá para escuchar</span>
  </button>
  <div id="music-player" class="music-player" aria-hidden="true"></div>

  <script>
    const cd = document.getElementById('countdown')!;
    const target = new Date(cd.dataset.target!).getTime();
    function tick() {
      const diff = target - Date.now();
      if (diff <= 0) { cd.textContent = '¡Es hoy!'; return; }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      const el = (p: string) => cd.querySelector(`[data-part="${p}"]`);
      if (el('d')) el('d')!.textContent = `${d}d`;
      if (el('h')) el('h')!.textContent = `${h}h`;
      if (el('m')) el('m')!.textContent = `${m}m`;
      if (el('s')) el('s')!.textContent = `${s}s`;
    }
    tick(); setInterval(tick, 1000);

    async function refreshCounter() {
      try {
        const r = await fetch('/api/rsvp');
        const j = await r.json();
        document.getElementById('counter')!.textContent = String(j.count ?? 0);
      } catch {}
    }
    refreshCounter(); setInterval(refreshCounter, 15000);

    // RSVP modal
    const modal = document.getElementById('rsvp-modal') as HTMLDialogElement;
    const openBtn = document.getElementById('rsvp-open')!;
    const closeBtn = document.getElementById('rsvp-close')!;
    let lastFocus: HTMLElement | null = null;
    openBtn.addEventListener('click', () => { lastFocus = document.activeElement as HTMLElement; modal.showModal(); });
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('close', () => { if (lastFocus) lastFocus.focus(); });

    const form = document.getElementById('rsvp-form') as HTMLFormElement;
    const status = document.getElementById('rsvp-status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        name: String(fd.get('name') || ''),
        companions: Number(fd.get('companions') || 0),
        dedication: String(fd.get('dedication') || ''),
      };
      const r = await fetch('/api/rsvp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (r.ok) {
        status.textContent = '¡Gracias por confirmar! Nos vemos en el cine.';
        form.reset();
        refreshCounter();
      } else {
        status.textContent = 'Error al enviar. Intentá de nuevo.';
      }
    });

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    // Playlist
    async function loadTracks() {
      const r = await fetch('/api/tracks');
      const j = await r.json();
      const ul = document.getElementById('track-list')!;
      ul.innerHTML = '';
      for (const t of j.tracks || []) {
        const li = document.createElement('li');
        const q = encodeURIComponent(`${t.title} ${t.artist}`);
        li.innerHTML = `<span class="text-gray-100">${esc(t.title)}</span> <span class="text-gray-500">— ${esc(t.artist)}</span> <a href="https://open.spotify.com/search/${q}" target="_blank" rel="noopener" class="text-neon-green underline ml-2">buscar</a>`;
        ul.appendChild(li);
      }
    }
    loadTracks();
    const trackForm = document.getElementById('track-form') as HTMLFormElement;
    const trackStatus = document.getElementById('track-status')!;
    trackForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(trackForm);
      const payload = { title: String(fd.get('title') || ''), artist: String(fd.get('artist') || '') };
      const r = await fetch('/api/tracks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (r.ok) { trackStatus.textContent = '¡Sumada!'; trackForm.reset(); loadTracks(); }
      else { trackStatus.textContent = 'No se pudo agregar.'; }
    });

    // Galeria: carrusel horizontal con scroll infinito (duplica la pista y reacomoda)
    const pista = document.getElementById('gallery-pista')!;
    const gal = document.getElementById('gallery')!;

    function cardHtml(p: any) {
      return `<figure class="gallery-item">
        <img src="${esc(p.url)}" alt="${esc(p.alt)}" loading="lazy" class="w-full h-full object-cover" />
        <button data-id="${p.id}" class="like-btn absolute bottom-2 right-2 bg-black/60 rounded-full px-3 py-1 text-sm text-white flex items-center gap-1" aria-label="Me gusta esta foto">
          <span class="heart" aria-hidden="true">${p.liked ? '❤️' : '🤍'}</span> <span class="count">${p.likes}</span>
        </button>
      </figure>`;
    }

    async function loadGallery() {
      const r = await fetch('/api/photos');
      const j = await r.json();
      const photos = j.photos || [];
      const html = photos.map(cardHtml).join('');
      // 3 copias para que al hacer scroll nunca se vea el borde
      pista.innerHTML = html + html + html;
      const width = pista.scrollWidth / 3;
      gal.scrollLeft = width;
      bindLikes();
    }

    function bindLikes() {
      pista.querySelectorAll('.like-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = Number((btn as HTMLElement).dataset.id);
          const r = await fetch('/api/likes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ photoId: id }) });
          if (r.ok) {
            const j = await r.json();
            pista.querySelectorAll(`.like-btn[data-id="${id}"]`).forEach((b) => {
              (b.querySelector('.count') as HTMLElement).textContent = String(j.likes);
              (b.querySelector('.heart') as HTMLElement).textContent = '❤️';
            });
          }
        });
      });
    }

    // Scroll infinito: al llegar al final, salta una copia atras
    gal.addEventListener('scroll', () => {
      const width = pista.scrollWidth / 3;
      if (!width) return;
      if (gal.scrollLeft >= width * 2) gal.scrollLeft -= width;
      else if (gal.scrollLeft <= 0) gal.scrollLeft += width;
    }, { passive: true });

    // Arrastre con mouse (en el celu ya scrollea nativo)
    let drag = false;
    let startX = 0;
    let startLeft = 0;
    gal.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      drag = true;
      startX = e.clientX;
      startLeft = gal.scrollLeft;
      gal.classList.add('dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      gal.scrollLeft = startLeft - (e.clientX - startX);
    });
    window.addEventListener('pointerup', () => {
      drag = false;
      gal.classList.remove('dragging');
    });

    loadGallery();
  </script>

  <script>
    // Parallax decorativo: globos y confetis suben solo al scrollear.
    const decor = document.getElementById('decor');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (decor && !reduceMotion) {
      let ticking = false;
      const update = () => { decor.style.setProperty('--scroll', String(window.scrollY)); ticking = false; };
      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    }
  </script>

  <script>
    // Música de fondo: YouTube IFrame API con autoplay muteado + control on/off.
    const btn = document.getElementById('music-toggle')!;
    const icon = document.getElementById('music-icon')!;
    const hint = document.getElementById('music-hint')!;
    const YT_ID = 'PIb6AZdTr-A';

    let player: any = null;
    let playing = true;
    let unmuted = false;
    let available = true;

    function render() {
      if (!available) {
        icon.textContent = '🚫';
        hint.textContent = 'No disponible';
        btn.setAttribute('aria-pressed', 'false');
        return;
      }
      icon.textContent = playing ? '🎵' : '🔇';
      hint.textContent = unmuted ? '' : 'Tocá para escuchar';
      btn.setAttribute('aria-pressed', String(playing));
    }

    function loadApi() {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
    }

    (window as any).onYouTubeIframeAPIReady = () => {
      try {
        player = new (window as any).YT.Player('music-player', {
          width: '1',
          height: '1',
          videoId: YT_ID,
          playerVars: { autoplay: 1, mute: 1, loop: 1, playlist: YT_ID, controls: 0, rel: 0 },
          events: { onReady: (e: any) => { try { e.target.playVideo(); } catch {} } },
        });
      } catch {
        available = false;
        render();
      }
    };

    loadApi();
    setTimeout(() => { if (!player) { available = false; render(); } }, 10000);

    function unmuteOnce() {
      if (unmuted || !player) return;
      try { player.unMute(); unmuted = true; } catch {}
      render();
      window.removeEventListener('pointerdown', unmuteOnce);
      window.removeEventListener('keydown', unmuteOnce);
    }
    window.addEventListener('pointerdown', unmuteOnce);
    window.addEventListener('keydown', unmuteOnce);

    btn.addEventListener('click', () => {
      if (!available || !player) return;
      try {
        if (playing) player.pauseVideo();
        else { player.playVideo(); player.unMute(); unmuted = true; }
        playing = !playing;
      } catch {}
      render();
    });

    render();

    // Fondo: se difumina apenas el hero sale del viewport.
    const hero = document.getElementById('hero');
    const fondo = document.querySelector('.fondo-cine');
    if (hero && fondo) {
      new IntersectionObserver(
        ([entry]) => fondo.classList.toggle('difuminado', !entry.isIntersecting),
        { threshold: 0 },
      ).observe(hero);
    }
  </script>
</Layout>
