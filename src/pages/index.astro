---
import Layout from '../layouts/Layout.astro';
import '../lib/env';
import { EVENT } from '../data/event';
import { AWARDS, AWARDS_INTRO } from '../data/awards';
import { MOVIES } from '../data/movies';

const mitad = Math.ceil(MOVIES.length / 2);
const peliculasArriba = MOVIES.slice(0, mitad);
const peliculasAbajo = MOVIES.slice(mitad).reverse();

const giftAlias = process.env.GIFT_ALIAS;
const giftRecipient = process.env.GIFT_RECIPIENT;
const giftAccount = process.env.GIFT_ACCOUNT;
const giftConfigured = Boolean(giftAlias && giftRecipient);
---

<Layout
  title="Juli: capítulo 30, la película"
  description="Los 30 de Juli, con tema de cine: disfraces, premios y una playlist armada entre todos. Confirmá tu asistencia."
>
  <!-- Fondo único: horizontal en desktop, vertical en mobile. Se difumina al scrollear. -->
  <div class="fondo-cine" aria-hidden="true"></div>

  <section id="hero" class="relative flex min-h-screen flex-col items-center justify-center gap-6 px-4 text-center">
    <p class="text-neon-cyan text-sm tracking-widest uppercase">Estreno · {EVENT.date}</p>
    <h1 class="text-4xl font-bold text-neon-magenta neon-text sm:text-6xl">Juli protagoniza:</h1>
    <div class="marquee w-full max-w-2xl text-3xl font-bold text-neon-green neon-text sm:text-5xl" tabindex="0">
      <span>legalmente 30</span>
    </div>
    <p class="max-w-xl text-lg text-gray-200">
      Algunas historias merecen una secuela. La mía cumple 30 y la fiesta es de disfraces. ¿Te sumás al reparto?
    </p>
    <div id="countdown" data-target={EVENT.dateISO} class="flex gap-4 text-neon-green font-mono text-2xl" role="timer" aria-label="Cuenta regresiva para la fiesta">
      <span data-part="d">--d</span><span data-part="h">--h</span><span data-part="m">--m</span><span data-part="s">--s</span>
    </div>
    <div class="flex flex-col items-center gap-3">
      <button id="rsvp-open" class="rounded bg-neon-magenta px-6 py-3 font-semibold text-black shadow-[0_0_22px_rgba(255,0,255,0.45)] hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-cinema-black">Confirmar asistencia</button>
      <p class="text-sm text-gray-300">Ya confirmaron: <span id="counter">0</span> <span id="counter-note">personas</span></p>
    </div>
  </section>

  <!-- Ubicacion -->
  <section id="ubicacion" class="relative mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-cinema-gold mb-4">Dónde y cuándo</h2>
    <p class="text-xl text-gray-100 font-semibold">{EVENT.venue}</p>
    <p class="text-gray-300 mt-1">{EVENT.address}</p>
    <p class="text-neon-green mt-3 text-lg">{EVENT.date} · {EVENT.time}</p>
    <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="mt-5 inline-block min-h-11 rounded border border-neon-cyan px-4 py-2 text-neon-cyan hover:bg-neon-cyan hover:text-black focus:outline-none focus:ring-2 focus:ring-neon-magenta">Ver en Google Maps</a>
  </section>

  <!-- Foto destacada de Juli, justo debajo de la ubicacion -->
  <section class="relative mx-auto max-w-2xl px-4 pb-8">
    <img
      src="/img/photos/julifiesta.webp"
      alt="Juli con saco blanco y short rosa en la fiesta, de noche, entre luces de colores"
      loading="lazy"
      class="w-full rounded-xl border border-neon-cyan/25 object-cover"
    />
  </section>

  <!-- Qué hay que traer: dress code, adultos y bebida en tarjetas compactas -->
  <section id="que-traer" class="relative mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-2xl font-bold text-cinema-gold mb-6 text-center">Qué hay que traer</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded border border-neon-cyan/25 bg-gray-950/90 p-4">
        <h3 class="font-semibold text-cinema-gold flex items-center gap-2"><span aria-hidden="true">🎭</span> Disfraz obligatorio</h3>
        <p class="text-sm text-gray-200 mt-1">Disfraz obligatorio y temático. Si venís de civil, te toca ser extra de fondo. Durante la noche se entregan premios especiales.</p>
      </div>
      <div class="rounded border border-neon-cyan/25 bg-gray-950/90 p-4">
        <h3 class="font-semibold text-cinema-gold flex items-center gap-2"><span aria-hidden="true">🥂</span> Solo adultos</h3>
        <p class="text-sm text-gray-200 mt-1">Esta función es para adultos. No traigas chicos: la noche es para grandes disfrazados.</p>
      </div>
      <div class="rounded border border-neon-cyan/25 bg-gray-950/90 p-4">
        <h3 class="font-semibold text-cinema-gold flex items-center gap-2"><span aria-hidden="true">🎟️</span> Tu presencia</h3>
        <p class="text-sm text-gray-200 mt-1">Lo único imprescindible. Con aparecer ya ganás el premio al mejor apoyo.</p>
      </div>
      <div class="rounded border border-neon-cyan/25 bg-gray-950/90 p-4">
        <h3 class="font-semibold text-cinema-gold flex items-center gap-2"><span aria-hidden="true">🍸</span> Lo que vayas a tomar</h3>
        <p class="text-sm text-gray-200 mt-1">Cada uno trae su propia bebida alcohólica: cerveza, vino, vodka, fernet, lo que tomes. Si no tomás, también vale tu presencia.</p>
      </div>
    </div>
  </section>

  <!-- Carrusel de peliculas: reemplaza las ideas de disfraz -->
  <section class="relative mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-cinema-gold mb-2 text-center">Peliculas para inspirarte</h2>
    <p class="text-center text-sm text-gray-400 mb-8">Algunas referencias para tu disfraz.</p>
    <div class="space-y-4 overflow-hidden">
      <div class="movie-row movie-row--left flex gap-3" tabindex="0" role="group" aria-label="Pósters de películas: fila de arriba">
        <div class="movie-set flex gap-3">
          {peliculasArriba.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
        </div>
        <div class="movie-set movie-dup flex gap-3" aria-hidden="true">
          {peliculasArriba.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
        </div>
      </div>
      <div class="movie-row movie-row--right flex gap-3" tabindex="0" role="group" aria-label="Pósters de películas: fila de abajo">
        <div class="movie-set flex gap-3">
          {peliculasAbajo.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
        </div>
        <div class="movie-set movie-dup flex gap-3" aria-hidden="true">
          {peliculasAbajo.map((m) => (<img src={m} alt="" loading="lazy" class="movie-card" />))}
        </div>
      </div>
    </div>
  </section>

  <!-- Premios -->
  <section id="premios" class="relative mx-auto max-w-4xl px-4 py-16">
    <h2 class="text-2xl font-bold text-cinema-gold mb-4 text-center">Los Premios de la Noche</h2>
    <p class="text-center text-gray-200 max-w-2xl mx-auto">{AWARDS_INTRO}</p>
    <p class="mt-5 text-center">
      <a id="ir-a-votar" href="/votar" hidden class="inline-block rounded bg-neon-magenta px-5 py-3 font-semibold text-black hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-cinema-black">Votar por los premios</a>
    </p>
    <p id="awards-more" class="mt-5 text-center text-gray-300">y varias categorías más</p>
    <div id="premios-suspenso" hidden class="mt-6 text-center" role="status" aria-live="polite">
      <p class="text-4xl" aria-hidden="true">🎬</p>
      <p class="mt-2 font-semibold text-neon-magenta motion-safe:animate-pulse">Revelando ganadores…</p>
    </div>
    <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {AWARDS.map((a, i) => (
        <li class="rounded border border-cinema-gold/40 bg-gray-950/90 p-3 text-sm" data-award={a.slug} hidden={i >= 2}>
          <div class="award-winner" hidden></div>
          <p><span aria-hidden="true">{a.emoji}</span> <span class="font-semibold text-cinema-gold">{a.title}</span></p>
          <p class="text-gray-400 mt-1">{a.teaser}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Regalos -->
  <section id="regalos" class="relative mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-cinema-gold mb-4">Regalos</h2>
    {giftConfigured ? (
      <div class="mx-auto max-w-md rounded border border-cinema-gold/40 bg-gray-950/90 p-4">
        <p class="text-gray-200">Si querés hacerme un regalo, podés transferir a:</p>
        <p class="mt-3 text-cinema-gold font-semibold">Alias: {giftAlias}</p>
        <p class="text-gray-200">{giftRecipient}</p>
        {giftAccount && <p class="text-gray-400 text-sm mt-1">Cuenta: {giftAccount}</p>}
      </div>
    ) : (
      <p class="mx-auto max-w-md rounded border border-cinema-gold/40 bg-gray-950/90 p-4 text-gray-300">
        Estamos preparando los datos para regalos. Pronto vas a poder ver acá el alias y la cuenta.
      </p>
    )}
  </section>

  <!-- Julilogramos antes de la playlist -->
  <section class="relative mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-cinema-gold mb-4">Te espero, no me falles</h2>
    <img
      src="/img/photos/juli-logramos-2025.webp"
      alt="Juli sosteniendo un cartel de “Lo logramos 2025” junto a la fuente iluminada"
      loading="lazy"
      class="mx-auto w-full rounded-xl border border-neon-cyan/25 object-cover"
    />
  </section>

  <!-- Playlist -->
  <section class="relative mx-auto max-w-2xl px-4 py-16">
    <h2 class="text-2xl font-bold text-cinema-gold mb-2 text-center">La banda sonora</h2>
    <p class="text-center text-gray-200 mb-6">¿Qué temazo no puede faltar esta noche? Sumá la tuya y armamos la playlist entre todos.</p>
    <iframe class="w-full aspect-video rounded" src={`https://open.spotify.com/embed/playlist/${EVENT.spotifyPlaylist}`} allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="Playlist de la fiesta"></iframe>
    <form id="track-form" class="mt-6 flex flex-col gap-2 sm:flex-row">
      <label for="track-title" class="sr-only">Canción</label>
      <input id="track-title" name="title" placeholder="Canción" required maxlength="100" class="min-h-11 flex-1 rounded bg-gray-900 px-3 py-2 border border-gray-500 focus:border-neon-cyan focus:outline-none" />
      <label for="track-artist" class="sr-only">Artista</label>
      <input id="track-artist" name="artist" placeholder="Artista" required maxlength="100" class="min-h-11 flex-1 rounded bg-gray-900 px-3 py-2 border border-gray-500 focus:border-neon-cyan focus:outline-none" />
      <button class="min-h-11 rounded bg-neon-green px-4 py-2 text-black font-semibold hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan">Sumar</button>
    </form>
    <p id="track-status" class="text-sm text-neon-green mt-2" role="status" aria-live="polite"></p>
    <ul id="track-list" class="mt-4 space-y-2 text-sm text-gray-200"></ul>
  </section>

  <!-- RSVP modal -->
  <dialog id="rsvp-modal" aria-labelledby="rsvp-title" class="rounded-lg bg-gray-900 text-gray-100 p-6 w-full max-w-md backdrop:bg-black/70">
    <form id="rsvp-form" class="space-y-4">
      <h2 id="rsvp-title" class="text-xl font-bold text-neon-magenta">Confirmar asistencia</h2>
      <div>
        <label for="name" class="block text-sm mb-1">Nombre</label>
        <input id="name" name="name" required maxlength="100" class="min-h-11 w-full rounded bg-gray-800 px-3 py-2 border border-gray-500 focus:border-neon-cyan focus:outline-none" />
      </div>
      <div>
        <label for="companions" class="block text-sm mb-1">Acompañantes</label>
        <input id="companions" name="companions" type="number" min="0" max="20" value="0" class="min-h-11 w-full rounded bg-gray-800 px-3 py-2 border border-gray-500 focus:border-neon-cyan focus:outline-none" />
      </div>
      <div>
        <label for="dedication" class="block text-sm mb-1">Dedicatoria (opcional)</label>
        <textarea id="dedication" name="dedication" rows="3" maxlength="500" class="w-full rounded bg-gray-800 px-3 py-2 border border-gray-500 focus:border-neon-cyan focus:outline-none"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" id="rsvp-close" class="min-h-11 px-4 py-2 text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-neon-cyan">Cerrar</button>
        <button type="submit" class="min-h-11 rounded bg-neon-magenta px-4 py-2 text-black font-semibold hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-neon-cyan">Enviar</button>
      </div>
      <p id="rsvp-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <!-- Decoración fija: pocos globos y confetis, se mueven solo con el scroll. -->
  <div class="decor" id="decor" aria-hidden="true">
    <span class="decor-balloon" style="left:5%;top:84%;font-size:2.75rem;--v:0.09">🎈</span>
    <span class="decor-balloon" style="left:88%;top:70%;font-size:2rem;--v:0.05">🎈</span>
    <span class="decor-balloon" style="left:72%;top:92%;font-size:3rem;--v:0.12">🎈</span>
    <span class="decor-balloon" style="left:22%;top:60%;font-size:1.6rem;--v:0.03">🎈</span>
    <span class="decor-confetti" style="left:12%;top:35%;--c:#ff00ff;--r:18deg;--v:0.07"></span>
    <span class="decor-confetti" style="left:35%;top:70%;--c:#00f0ff;--r:-30deg;--v:0.04"></span>
    <span class="decor-confetti" style="left:58%;top:28%;--c:#39ff14;--r:45deg;--v:0.10"></span>
    <span class="decor-confetti" style="left:79%;top:48%;--c:#d4af37;--r:-12deg;--v:0.06"></span>
    <span class="decor-confetti" style="left:93%;top:22%;--c:#ff6b6b;--r:60deg;--v:0.08"></span>
    <span class="decor-confetti" style="left:47%;top:88%;--c:#ffffff;--r:10deg;--v:0.05"></span>
  </div>

  <!-- Música de fondo -->
  <button
    id="music-toggle"
    type="button"
    class="fixed bottom-4 right-4 z-50 flex min-h-11 items-center gap-2 rounded-full border border-neon-cyan/50 bg-gray-950/80 px-4 py-2 text-sm text-neon-cyan backdrop-blur focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-cinema-black"
    aria-pressed="false"
    aria-label="Música de fondo"
  >
    <span id="music-icon" aria-hidden="true">🎵</span>
    <span id="music-hint">Tocá para escuchar</span>
  </button>
  <div id="music-player" class="music-player" aria-hidden="true"></div>

  <script>
    const cd = document.getElementById('countdown')!;
    const target = new Date(cd.dataset.target!).getTime();
    let cdTimer: ReturnType<typeof setInterval> | null = null;
    function tick() {
      const diff = target - Date.now();
      if (diff <= 0) {
        cd.textContent = '¡Es hoy!';
        if (cdTimer) { clearInterval(cdTimer); cdTimer = null; }
        return;
      }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      const el = (p: string) => cd.querySelector(`[data-part="${p}"]`);
      if (el('d')) el('d')!.textContent = `${d}d`;
      if (el('h')) el('h')!.textContent = `${h}h`;
      if (el('m')) el('m')!.textContent = `${m}m`;
      if (el('s')) el('s')!.textContent = `${s}s`;
    }
    tick();
    if (target > Date.now()) cdTimer = setInterval(tick, 1000);

    // fetch con timeout: evita dejar el botón colgado y promesas sin manejar.
    async function request(url: string, init?: RequestInit) {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 8000);
      try { return await fetch(url, { ...init, signal: ctrl.signal }); }
      finally { clearTimeout(timer); }
    }

    const counter = document.getElementById('counter')!;
    const counterNote = document.getElementById('counter-note')!;
    async function refreshCounter() {
      try {
        const r = await request('/api/rsvp');
        if (!r.ok) throw new Error('rsvp counter');
        const j = await r.json();
        counter.textContent = String(j.count ?? 0);
        counterNote.textContent = 'personas';
      } catch {
        counter.textContent = '—';
        counterNote.textContent = 'confirmaciones no disponibles';
      }
    }
    refreshCounter(); setInterval(refreshCounter, 15000);

    // RSVP modal
    const modal = document.getElementById('rsvp-modal') as HTMLDialogElement;
    const openBtn = document.getElementById('rsvp-open')!;
    const closeBtn = document.getElementById('rsvp-close')!;
    let lastFocus: HTMLElement | null = null;
    openBtn.addEventListener('click', () => { lastFocus = document.activeElement as HTMLElement; modal.showModal(); });
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('close', () => { if (lastFocus) lastFocus.focus(); });

    const form = document.getElementById('rsvp-form') as HTMLFormElement;
    const status = document.getElementById('rsvp-status')!;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn.disabled) return;
      const fd = new FormData(form);
      const payload = {
        name: String(fd.get('name') || ''),
        companions: Number(fd.get('companions') || 0),
        dedication: String(fd.get('dedication') || ''),
      };
      submitBtn.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const r = await request('/api/rsvp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!r.ok) throw new Error('rsvp');
        status.textContent = '¡Gracias por confirmar! Nos vemos en el cine.';
        form.reset();
        refreshCounter();
      } catch {
        status.textContent = 'No pudimos enviar la confirmación. Revisá tu conexión e intentá de nuevo.';
      } finally {
        submitBtn.disabled = false;
      }
    });

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    // Playlist
    const trackList = document.getElementById('track-list')!;
    const trackForm = document.getElementById('track-form') as HTMLFormElement;
    const trackStatus = document.getElementById('track-status')!;
    async function loadTracks() {
      try {
        const r = await request('/api/tracks');
        if (!r.ok) throw new Error('tracks');
        const j = await r.json();
        trackList.innerHTML = '';
        for (const t of j.tracks || []) {
          const li = document.createElement('li');
          const q = encodeURIComponent(`${t.title} ${t.artist}`);
          li.innerHTML = `<span class="text-gray-100">${esc(t.title)}</span> <span class="text-gray-400">— ${esc(t.artist)}</span> <a href="https://open.spotify.com/search/${q}" target="_blank" rel="noopener" class="text-neon-green underline ml-2">buscar</a>`;
          trackList.appendChild(li);
        }
        trackStatus.textContent = '';
      } catch {
        trackStatus.textContent = 'No se pudo cargar la lista de canciones.';
      }
    }
    loadTracks();
    trackForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(trackForm);
      const payload = { title: String(fd.get('title') || ''), artist: String(fd.get('artist') || '') };
      trackStatus.textContent = 'Sumando…';
      try {
        const r = await request('/api/tracks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!r.ok) throw new Error('track');
        trackStatus.textContent = '¡Sumada!';
        trackForm.reset();
        await loadTracks();
      } catch {
        trackStatus.textContent = 'No se pudo agregar la canción. Intentá de nuevo.';
      }
    });

    // Premios: preview de dos categorias y reveal de ganadores segun el estado del concurso.
    const suspenso = document.getElementById('premios-suspenso')!;
    const awardsMore = document.getElementById('awards-more')!;
    const voteBtn = document.getElementById('ir-a-votar')!;
    const awardItems = [...document.querySelectorAll<HTMLElement>('[data-award]')];

    let revealed = false;
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    function stopPolling() {
      if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    }
    function startPolling() {
      if (!pollTimer) pollTimer = setInterval(refreshContest, 10000);
    }

    function renderAwards(state: any) {
      const reveal = state.status === 'open' || state.status === 'closed';
      awardItems.forEach((li, i) => { if (i >= 2) li.hidden = !reveal; });
      awardsMore.hidden = reveal;
      voteBtn.hidden = state.status !== 'open';
    }

    function revealWinners(state: any) {
      if (revealed) return;
      const winners = (state.categories || []).filter((c: any) => c.winnerPhotoId);
      if (!winners.length) { revealed = true; return; }
      const paint = () => {
        revealed = true;
        suspenso.hidden = true;
        for (const w of winners) {
          const box = document.querySelector<HTMLElement>(`[data-award="${w.slug}"] .award-winner`);
          if (!box) continue;
          const url = `/api/photos/${w.winnerPhotoId}/file`;
          const alt = `Ganador: ${w.title}`;
          const votes = w.winnerVotes ? `<p class="mt-1 text-xs text-neon-green">${w.winnerVotes} votos</p>` : '';
          box.innerHTML = `<img src="${esc(url)}" alt="${esc(alt)}" loading="lazy" class="aspect-[3/4] w-full rounded object-cover" />${votes}`;
          box.hidden = false;
        }
      };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return paint();
      suspenso.hidden = false;
      setTimeout(paint, 4000);
    }

    async function refreshContest() {
      if (document.hidden) return;
      try {
        const r = await fetch('/api/contest');
        if (!r.ok) return;
        const state = await r.json();
        renderAwards(state);
        if (state.status === 'closed') {
          revealWinners(state);
          if (revealed) stopPolling();
        }
      } catch {}
    }

    refreshContest();
    startPolling();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { stopPolling(); return; }
      if (!revealed) { refreshContest(); startPolling(); }
    });

  </script>

  <script>
    // Parallax decorativo: globos y confetis suben solo al scrollear.
    const decor = document.getElementById('decor');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (decor && !reduceMotion) {
      let ticking = false;
      const update = () => { decor.style.setProperty('--scroll', String(window.scrollY)); ticking = false; };
      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    }
  </script>

  <script>
    // Música de fondo: YouTube IFrame API con autoplay muteado + control on/off.
    const btn = document.getElementById('music-toggle')!;
    const icon = document.getElementById('music-icon')!;
    const hint = document.getElementById('music-hint')!;
    const YT_ID = 'PIb6AZdTr-A';

    let player: any = null;
    let playing = true;
    let unmuted = false;
    let available = true;

    function render() {
      if (!available) {
        icon.textContent = '🚫';
        hint.textContent = 'No disponible';
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-label', 'Música no disponible');
        return;
      }
      if (!playing) {
        icon.textContent = '🔇';
        hint.textContent = 'Pausado';
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-label', 'Música pausada');
        return;
      }
      if (!unmuted) {
        icon.textContent = '🔈';
        hint.textContent = 'Tocá para escuchar';
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-label', 'Música silenciada');
        return;
      }
      icon.textContent = '🎵';
      hint.textContent = 'Sonando';
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', 'Música sonando');
    }

    function loadApi() {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
    }

    (window as any).onYouTubeIframeAPIReady = () => {
      try {
        player = new (window as any).YT.Player('music-player', {
          width: '1',
          height: '1',
          videoId: YT_ID,
          playerVars: { autoplay: 1, mute: 1, loop: 1, playlist: YT_ID, controls: 0, rel: 0 },
          events: { onReady: (e: any) => { try { e.target.playVideo(); } catch {} } },
        });
      } catch {
        available = false;
        render();
      }
    };

    loadApi();
    setTimeout(() => { if (!player) { available = false; render(); } }, 10000);

    function unmuteOnce(ev: Event) {
      if (unmuted || !player) return;
      if (ev.target instanceof Node && btn.contains(ev.target)) return;
      try { player.unMute(); unmuted = true; } catch {}
      render();
      window.removeEventListener('pointerdown', unmuteOnce);
      window.removeEventListener('keydown', unmuteOnce);
    }
    window.addEventListener('pointerdown', unmuteOnce);
    window.addEventListener('keydown', unmuteOnce);

    btn.addEventListener('click', () => {
      if (!available || !player) return;
      try {
        if (!playing) { player.playVideo(); player.unMute(); unmuted = true; playing = true; }
        else if (!unmuted) { player.unMute(); unmuted = true; }
        else { player.pauseVideo(); playing = false; }
      } catch {}
      render();
    });

    render();

    // Fondo: se difumina apenas el hero sale del viewport.
    const hero = document.getElementById('hero');
    const fondo = document.querySelector('.fondo-cine');
    if (hero && fondo) {
      new IntersectionObserver(
        ([entry]) => fondo.classList.toggle('difuminado', !entry.isIntersecting),
        { threshold: 0 },
      ).observe(hero);
    }
  </script>
</Layout>
