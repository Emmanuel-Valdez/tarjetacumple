---
import Layout from '../../layouts/Layout.astro';
import { verifySession } from '../../lib/auth';

const match = Astro.request.headers.get('cookie')?.match(/(?:^|;\s*)admin_session=([^;]+)/);
const role = verifySession(match ? decodeURIComponent(match[1]) : undefined);
if (!role) return Astro.redirect('/admin/login');
---
<Layout title="Admin">
  <section class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-neon-magenta">Panel admin · {role}</h1>
      <div class="flex items-center gap-4">
        <a href="/" class="text-sm text-neon-cyan hover:underline focus:outline-none focus:ring-2 focus:ring-neon-magenta">Volver a la invitación</a>
        <button id="logout" class="min-h-11 rounded px-2 text-sm text-gray-400 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">Salir</button>
      </div>
    </div>

    <h2 class="text-xl font-bold text-neon-cyan mb-3">RSVPs</h2>
    <div class="mb-3 flex gap-2">
      <button id="copy-list" class="min-h-11 rounded bg-neon-green px-3 py-1 text-black text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">Copiar lista</button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-gray-400">
          <tr><th class="py-2">Nombre</th><th>Acompañantes</th><th>Dedicatoria</th><th>Fecha</th><th></th></tr>
        </thead>
        <tbody id="rsvp-body"></tbody>
      </table>
    </div>

    <h2 class="text-xl font-bold text-neon-cyan mt-8 mb-3">Canciones de la playlist</h2>
    <ul id="track-body" class="text-sm space-y-2"></ul>

    <h2 class="text-xl font-bold text-neon-cyan mt-8 mb-3">Fotos</h2>
    <form id="upload-form" class="flex flex-col gap-2 sm:flex-row">
      <label for="upload-file" class="sr-only">Fotos</label>
      <input id="upload-file" type="file" name="file" accept="image/*" multiple required class="w-full cursor-pointer rounded bg-gray-900 p-1 text-sm text-gray-300 border border-gray-700 shrink-0 file:mr-3 file:cursor-pointer file:rounded file:border-0 file:bg-neon-cyan file:px-3 file:py-2 file:text-sm file:font-semibold file:text-black hover:file:bg-neon-cyan/80 focus:border-neon-cyan focus:outline-none sm:w-96" />
      <button class="min-h-11 rounded bg-neon-magenta px-4 py-2 text-black font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">Subir</button>
    </form>
    <p id="upload-status" class="text-sm mt-2" role="status" aria-live="polite"></p>
    <p id="photo-status" class="text-sm mt-2 text-red-400" role="alert" hidden></p>
    <div id="photo-grid" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6"></div>

    <h2 class="text-xl font-bold text-neon-cyan mt-8 mb-3">Categorías del concurso</h2>
    <p id="category-status" class="text-sm text-gray-400"></p>
    <p id="category-error" class="text-sm mt-2 text-red-400" role="alert" hidden></p>
    <form id="category-form" class="mt-3 grid gap-2 sm:grid-cols-[1fr_auto_2fr_auto]">
      <input id="category-title" class="min-h-11 rounded bg-gray-900 px-3 py-1 border border-gray-700 focus:border-neon-cyan focus:outline-none" placeholder="Título" required />
      <input id="category-emoji" class="min-h-11 rounded bg-gray-900 px-3 py-1 border border-gray-700 focus:border-neon-cyan focus:outline-none" placeholder="Emoji" required />
      <input id="category-teaser" class="min-h-11 rounded bg-gray-900 px-3 py-1 border border-gray-700 focus:border-neon-cyan focus:outline-none" placeholder="Teaser" required />
      <div class="flex gap-2">
        <button id="category-submit" class="min-h-11 rounded bg-neon-green px-3 py-1 text-black text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan disabled:cursor-not-allowed disabled:opacity-40">Crear</button>
        <button id="category-cancel" type="button" hidden class="min-h-11 rounded bg-gray-700 px-3 py-1 text-white text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">Cancelar</button>
      </div>
    </form>
    <ul id="category-list" class="mt-4 space-y-2"></ul>

    <h2 class="text-xl font-bold text-neon-cyan mt-8 mb-3">Concurso</h2>
    <p id="contest-status" class="text-sm text-gray-400"></p>
    <div class="mt-3 flex flex-wrap gap-2">
      <button id="contest-open" class="min-h-11 rounded bg-neon-green px-3 py-1 text-black text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan disabled:cursor-not-allowed disabled:opacity-40">Abrir</button>
      <button id="contest-close" class="min-h-11 rounded bg-red-500 px-3 py-1 text-black text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan disabled:cursor-not-allowed disabled:opacity-40">Cerrar</button>
    </div>
    <p id="contest-error" class="text-sm mt-2 text-red-400" role="alert" hidden></p>
    <div id="contest-tally" class="mt-4 space-y-4"></div>

    <div class="mt-8 rounded border border-red-900/60 p-4">
      <h3 class="font-semibold text-red-400">Reiniciar concurso</h3>
      <p class="text-sm text-gray-300 mt-1">Borra todos los votos y los ganadores. No lo uses durante la fiesta: es solo para ensayar.</p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <label for="contest-reset-word" class="text-sm text-gray-400">Escribí "reiniciar" para habilitar</label>
        <input id="contest-reset-word" class="min-h-11 rounded bg-gray-900 px-3 py-1 border border-gray-700 focus:border-neon-cyan focus:outline-none" />
        <button id="contest-reset" disabled class="min-h-11 rounded bg-red-500 px-3 py-1 text-black text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan disabled:cursor-not-allowed disabled:opacity-40">Reiniciar concurso</button>
      </div>
    </div>
  </section>

  <script>
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    async function loadRsvps() {
      const r = await fetch('/api/admin/rsvps');
      if (!r.ok) { window.location.href = '/admin/login'; return; }
      const j = await r.json();
      const tbody = document.getElementById('rsvp-body')!;
      tbody.innerHTML = '';
      for (const r of j.rsvps) {
        const tr = document.createElement('tr');
        tr.className = 'border-t border-gray-800';
        tr.innerHTML = `<td class="py-2">${esc(r.name)}</td><td>${r.companions}</td><td class="max-w-xs truncate">${esc(r.dedication)}</td><td>${new Date(r.createdAt).toLocaleString()}</td><td><button data-id="${r.id}" class="del min-h-11 rounded px-2 text-red-400 hover:text-red-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">borrar</button></td>`;
        tbody.appendChild(tr);
      }
      tbody.querySelectorAll('.del').forEach((b) => {
        b.addEventListener('click', async () => {
          const id = (b as HTMLElement).dataset.id;
          if (!confirm('¿Borrar este RSVP?')) return;
          await fetch(`/api/admin/rsvps?id=${id}`, { method: 'DELETE' });
          loadRsvps();
        });
      });
    }
    loadRsvps();

    document.getElementById('copy-list')!.addEventListener('click', async () => {
      const r = await fetch('/api/admin/rsvps');
      const j = await r.json();
      const text = j.rsvps.map((x: any) => `${x.name}\t${x.companions}\t${x.dedication || ''}`).join('\n');
      await navigator.clipboard.writeText(text);
      alert('Copiado');
    });

    document.getElementById('logout')!.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/admin/login';
    });

    // Canciones
    async function loadTracks() {
      const r = await fetch('/api/admin/tracks');
      if (!r.ok) return;
      const j = await r.json();
      const ul = document.getElementById('track-body')!;
      ul.innerHTML = '';
      if (!j.tracks.length) {
        ul.innerHTML = '<li class="text-gray-500">Todavia no hay canciones cargadas.</li>';
        return;
      }
      for (const t of j.tracks) {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 border-b border-gray-800 py-1';
        li.innerHTML = `<span>${esc(t.title)} <span class="text-gray-500">— ${esc(t.artist)}</span></span><button data-id="${t.id}" class="del-track min-h-11 rounded px-2 text-red-400 hover:text-red-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">borrar</button>`;
        ul.appendChild(li);
      }
      ul.querySelectorAll('.del-track').forEach((b) => {
        b.addEventListener('click', async () => {
          const id = (b as HTMLElement).dataset.id;
          if (!confirm('¿Borrar esta canción de la playlist?')) return;
          await fetch(`/api/admin/tracks?id=${id}`, { method: 'DELETE' });
          loadTracks();
        });
      });
    }
    loadTracks();

    // Fotos
    const photoStatus = document.getElementById('photo-status')!;

    async function loadPhotos() {
      const r = await fetch('/api/admin/photos');
      if (!r.ok) return;
      const j = await r.json();
      const grid = document.getElementById('photo-grid')!;
      grid.innerHTML = '';
      for (const p of j.photos) {
        const card = document.createElement('figure');
        card.className = 'relative rounded overflow-hidden';
        card.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.alt)}" loading="lazy" class="aspect-square w-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-black/70 px-2 py-1 text-xs">
            <span>Concurso</span>
            <button data-id="${p.id}" class="del-photo min-h-11 rounded px-2 text-red-400 hover:text-red-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan">borrar</button>
          </figcaption>`;
        grid.appendChild(card);
      }
      grid.querySelectorAll('.del-photo').forEach((b) => {
        b.addEventListener('click', async () => {
          const id = (b as HTMLElement).dataset.id;
          if (!confirm('¿Borrar esta foto? No se puede deshacer.')) return;
          const res = await fetch(`/api/admin/photos?id=${id}`, { method: 'DELETE' });
          if (!res.ok) {
            const j = await res.json().catch(() => ({}));
            photoStatus.textContent = j.error || 'No se pudo borrar la foto.';
            photoStatus.hidden = false;
            return;
          }
          photoStatus.hidden = true;
          loadPhotos();
        });
      });
    }
    loadPhotos();

    const uploadForm = document.getElementById('upload-form') as HTMLFormElement;
    const uploadStatus = document.getElementById('upload-status')!;
    const uploadInput = document.getElementById('upload-file') as HTMLInputElement;
    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const files = Array.from(uploadInput.files || []);
      if (!files.length) return;
      let ok = 0;
      let tooLarge = 0;
      let failed = 0;
      for (const [i, file] of files.entries()) {
        uploadStatus.textContent = `Subiendo ${i + 1} de ${files.length}...`;
        const fd = new FormData();
        fd.append('file', file);
        fd.append('alt', 'Foto del concurso');
        const r = await fetch('/api/admin/photos', { method: 'POST', body: fd });
        if (r.ok) {
          ok++;
        } else {
          const j = await r.json().catch(() => ({}));
          j.error === 'too large' ? tooLarge++ : failed++;
        }
      }
      const total = files.length;
      uploadStatus.textContent = ok === total
        ? `${ok} ${ok === 1 ? 'foto subida' : 'fotos subidas'}.`
        : `Subidas ${ok} de ${total}.${failed ? ` ${failed} fallaron.` : ''}${tooLarge ? ` ${tooLarge} superan los 12 MB.` : ''}`;
      uploadForm.reset();
      loadPhotos();
    });

    // Categorías

    const categoryError = document.getElementById('category-error')!;
    const categoryForm = document.getElementById('category-form') as HTMLFormElement;
    const categoryTitle = document.getElementById('category-title') as HTMLInputElement;
    const categoryEmoji = document.getElementById('category-emoji') as HTMLInputElement;
    const categoryTeaser = document.getElementById('category-teaser') as HTMLInputElement;
    const categorySubmit = document.getElementById('category-submit') as HTMLButtonElement;
    const categoryCancel = document.getElementById('category-cancel') as HTMLButtonElement;
    const categoryList = document.getElementById('category-list')!;
    let editingCategoryId: number | null = null;
    let contestIsIdle = true;

    function setCategoryEditingEnabled(enabled: boolean) {
      contestIsIdle = enabled;
      categoryTitle.disabled = !enabled;
      categoryEmoji.disabled = !enabled;
      categoryTeaser.disabled = !enabled;
      categorySubmit.disabled = !enabled;
      categoryList.querySelectorAll<HTMLButtonElement>('.edit-category, .del-category').forEach((b) => {
        b.disabled = !enabled;
      });
    }

    async function loadCategories() {
      const r = await fetch('/api/admin/contest-categories');
      if (!r.ok) return;
      const j = await r.json();
      categoryList.innerHTML = '';
      if (!j.categories.length) {
        categoryList.innerHTML = '<li class="text-gray-500">Todavía no hay categorías cargadas.</li>';
        return;
      }
      for (const c of j.categories) {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 border-b border-gray-800 py-2';
        li.innerHTML = `<span><span aria-hidden="true">${esc(c.emoji)}</span> <span class="font-semibold text-cinema-gold">${esc(c.title)}</span> <span class="text-gray-500">— ${esc(c.teaser)}</span></span>
          <span class="flex gap-2">
            <button data-id="${c.id}" class="edit-category min-h-11 rounded px-2 text-neon-cyan hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan disabled:cursor-not-allowed disabled:opacity-40">editar</button>
            <button data-id="${c.id}" class="del-category min-h-11 rounded px-2 text-red-400 hover:text-red-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan disabled:cursor-not-allowed disabled:opacity-40">borrar</button>
          </span>`;
        categoryList.appendChild(li);
      }
      categoryList.querySelectorAll<HTMLButtonElement>('.edit-category').forEach((b) => {
        b.addEventListener('click', () => {
          const id = Number((b as HTMLElement).dataset.id);
          const c = j.categories.find((x: any) => x.id === id);
          if (!c) return;
          editingCategoryId = id;
          categoryTitle.value = c.title;
          categoryEmoji.value = c.emoji;
          categoryTeaser.value = c.teaser;
          categorySubmit.textContent = 'Guardar';
          categoryCancel.hidden = false;
        });
      });
      categoryList.querySelectorAll<HTMLButtonElement>('.del-category').forEach((b) => {
        b.addEventListener('click', async () => {
          const id = (b as HTMLElement).dataset.id;
          if (!confirm('¿Borrar esta categoría?')) return;
          const res = await fetch(`/api/admin/contest-categories?id=${id}`, { method: 'DELETE' });
          if (!res.ok) {
            const jj = await res.json().catch(() => ({}));
            categoryError.textContent = jj.error || 'No se pudo borrar la categoría.';
            categoryError.hidden = false;
            return;
          }
          categoryError.hidden = true;
          loadCategories();
        });
      });
      setCategoryEditingEnabled(contestIsIdle);
    }

    categoryCancel.addEventListener('click', () => {
      editingCategoryId = null;
      categoryForm.reset();
      categorySubmit.textContent = 'Crear';
      categoryCancel.hidden = true;
    });

    categoryForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!contestIsIdle) return;
      const body: Record<string, unknown> = {
        title: categoryTitle.value.trim(),
        emoji: categoryEmoji.value.trim(),
        teaser: categoryTeaser.value.trim(),
      };
      const url = editingCategoryId ? '/api/admin/contest-categories' : '/api/admin/contest-categories';
      const method = editingCategoryId ? 'PATCH' : 'POST';
      if (editingCategoryId) body.id = editingCategoryId;
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        const jj = await res.json().catch(() => ({}));
        categoryError.textContent = jj.error || 'No se pudo guardar la categoría.';
        categoryError.hidden = false;
        return;
      }
      categoryError.hidden = true;
      editingCategoryId = null;
      categoryForm.reset();
      categorySubmit.textContent = 'Crear';
      categoryCancel.hidden = true;
      loadCategories();
    });

    // Concurso
    const contestStatusEl = document.getElementById('contest-status')!;
    const contestTally = document.getElementById('contest-tally')!;
    const contestError = document.getElementById('contest-error')!;
    const contestOpen = document.getElementById('contest-open') as HTMLButtonElement;
    const contestClose = document.getElementById('contest-close') as HTMLButtonElement;
    const resetWord = document.getElementById('contest-reset-word') as HTMLInputElement;
    const resetButton = document.getElementById('contest-reset') as HTMLButtonElement;
    const STATUS_LABEL: Record<string, string> = {
      idle: 'Todavía no abrió.',
      open: 'Abierto: se puede votar.',
      closed: 'Cerrado: los ganadores están congelados.',
    };

    async function loadContest() {
      const r = await fetch('/api/admin/contest');
      if (!r.ok) return;
      const j = await r.json();
      contestStatusEl.textContent = `${STATUS_LABEL[j.status] || j.status} · ${j.totalVotes} votos`;
      contestOpen.disabled = j.status !== 'idle';
      contestClose.disabled = j.status !== 'open';
      contestIsIdle = j.status === 'idle';
      setCategoryEditingEnabled(contestIsIdle);
      contestTally.innerHTML = '';
      if (!j.categories.length) {
        contestTally.innerHTML = '<p class="text-sm text-gray-500">Todavía no hay categorías congeladas: abrí el concurso para fijarlas.</p>';
        loadCategories();
        return;
      }
      for (const c of j.categories) {
        const candidates = [...c.tally].sort((a: any, b: any) => b.votes - a.votes || a.photoId - b.photoId);
        const box = document.createElement('div');
        box.className = 'rounded border border-gray-800 p-3';
        box.innerHTML = `<h3 class="font-semibold text-cinema-gold">${esc(c.emoji)} ${esc(c.title)}</h3>
          ${c.winnerPhotoId ? `<p class="text-xs text-neon-green">Ganador: foto ${c.winnerPhotoId} con ${c.winnerVotes ?? 0} votos</p>` : ''}
          <div class="mt-2 flex flex-wrap gap-3"></div>`;
        const list = box.querySelector('div')!;
        for (const p of candidates) {
          const item = document.createElement('figure');
          item.className = 'w-24';
          item.innerHTML = `<img src="${esc(p.url)}" alt="${esc(p.alt)}" loading="lazy" class="aspect-square w-full rounded object-cover" />
            <figcaption class="mt-1 text-center text-xs text-gray-300">${p.votes} votos</figcaption>`;
          list.appendChild(item);
        }
        contestTally.appendChild(box);
      }
      loadCategories();
    }

    async function contestAction(action: string, body: Record<string, string> = {}) {
      const r = await fetch('/api/admin/contest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, ...body }),
      });
      const j = await r.json().catch(() => ({}));
      contestError.textContent = r.ok ? '' : j.error || 'No se pudo ejecutar la acción.';
      contestError.hidden = r.ok;
      loadContest();
    }

    contestOpen.addEventListener('click', () => contestAction('open'));
    contestClose.addEventListener('click', () => {
      if (!confirm('Una vez cerrado no se puede volver a abrir. ¿Cerrar el concurso?')) return;
      contestAction('close');
    });
    resetWord.addEventListener('input', () => {
      resetButton.disabled = resetWord.value !== 'reiniciar';
    });
    resetButton.addEventListener('click', async () => {
      await contestAction('reset', { confirm: resetWord.value });
      resetWord.value = '';
      resetButton.disabled = true;
    });
    loadContest();
  </script>
</Layout>
