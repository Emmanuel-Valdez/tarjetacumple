---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Juli: capítulo 30, la película', description } = Astro.props;
const ogImage = new URL('/img/og.png', Astro.url).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/img/icon-512.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <title>{title}</title>
    {description && (
      <>
        <meta name="description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content="Sala de cine con el cartel de la fiesta" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
  </head>
  <body class="min-h-screen bg-cinema-black text-gray-100 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:min-h-11 focus:bg-neon-cyan focus:text-black focus:rounded">Saltar al contenido</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>