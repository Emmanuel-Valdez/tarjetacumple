---
import '../styles/global.css';
interface Props { title?: string; }
const { title = 'Juli: capitulo 30, la pelicula' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/img/icon-512.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-cinema-black text-gray-100 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-neon-cyan focus:text-black focus:rounded">Saltar al contenido</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>